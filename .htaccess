# Ashoka Group — clean URLs (hide the .html extension)

DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # If this site lives in a subfolder (e.g. example.com/ashoka/) instead of
  # the domain/subdomain root, change this to match, e.g. RewriteBase /ashoka/
  RewriteBase /

  # 1) If someone requests a URL with .html in it, redirect (visibly) to the
  #    clean version — keeps old links/bookmarks working and avoids duplicate
  #    URLs for the same page.
  RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /(.+)\.html[\ ?] [NC]
  RewriteRule ^ /%1 [R=301,L]

  # 2) Internally serve the matching .html file for the clean URL, without
  #    changing what shows in the address bar.
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.*)$ $1.html [L]
</IfModule>

# Branded 404 page for old/removed URLs still indexed elsewhere.
ErrorDocument 404 /404.html
